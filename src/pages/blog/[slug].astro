---
import Base from '../../layouts/Base.astro';
import Parts from '../../components/Parts.astro';
import { all, labels, slug as sl, plain, fmt, dshort } from '../../lib/posts';
import { find, src } from '../../lib/img';
export function getStaticPaths() { return all.map((p, i) => ({ params: { slug: p.slug }, props: { p, prev: all[i + 1], next: all[i - 1] } })); }
const { p, prev, next } = Astro.props;
const body = p.parts.filter((x) => !(x.t === 'img' && x.src === p.cover && p.parts.indexOf(x) === 0 && false));
const text = plain(p.parts.filter((x) => x.t === 'html').map((x) => x.html).join(' '));
const desc = (p.seoDescription || p.excerpt || text).replace(/\s+/g, ' ').slice(0, 158);
let og = '/og.jpg'; try { if (p.cover) { const e = find(p.cover); og = src(e, e.widths.includes(1280) ? 1280 : e.widths[e.widths.length - 1], 'webp'); } } catch {}
const url = `https://www.soundsinme.com/blog/${p.slug}`;
const ld = [{ '@context': 'https://schema.org', '@type': 'BlogPosting', headline: p.title, description: desc, datePublished: p.date, dateModified: p.updated, mainEntityOfPage: url, image: 'https://www.soundsinme.com' + og, author: { '@type': 'Person', name: 'Alejandro Traver' }, publisher: { '@id': 'https://www.soundsinme.com/#org' }, keywords: labels(p).join(', ') },
  { '@context': 'https://schema.org', '@type': 'BreadcrumbList', itemListElement: [{ '@type': 'ListItem', position: 1, name: 'Sounds', item: 'https://www.soundsinme.com/blog' }, { '@type': 'ListItem', position: 2, name: p.title, item: url }] }];
---
<Base title={`${p.title} | Sounds In Me`} description={desc} path={`/blog/${p.slug}`} current="blog" theme="dark" image={og} type="article" ld={ld} published={p.date} modified={p.updated}>
  <article class="post">
    <div class="post__in">
      <div class="meta">{p.categories.length > 0 && <ul class="tags">{p.categories.map((t) => <li><a href={`/blog/tag/${sl(t)}`}>{t}</a></li>)}</ul>}<time datetime={p.date}>{dshort(p.date)}</time></div>
      <h1>{p.title}</h1>
      
      <div class="prose"><Parts parts={body} title={p.title} /></div>
      {p.tags.length > 0 && <ul class="tags tags--end">{p.tags.map((t) => <li><a href={`/blog/tag/${sl(t)}`}>{t}</a></li>)}</ul>}
    </div>
  </article>
  <nav class="post-nav" aria-label="Más entradas">
    {next ? <a href={`/blog/${next.slug}`} rel="next"><span class="ch" aria-hidden="true">‹</span><span class="t3">{next.title}</span></a> : <span></span>}
    {prev ? <a href={`/blog/${prev.slug}`} rel="prev"><span class="t3">{prev.title}</span><span class="ch" aria-hidden="true">›</span></a> : <span></span>}
  </nav>
</Base>
